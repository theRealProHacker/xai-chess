diff --git a/src/nnue/nnue_dump.h b/src/nnue/nnue_dump.h
new file mode 100644
index 0000000..ed729e5
--- /dev/null
+++ b/src/nnue/nnue_dump.h
@@ -0,0 +1,41 @@
+/*
+  xai-chess NNUE forward-pass dump (Stockfish 18).
+
+  Capture buffer for every intermediate tensor of the BIG network's forward pass.
+  Inactive unless dumpTarget is non-null. The hooks are a null-pointer test on a
+  thread_local, never taken during search, so search behaviour is unchanged --
+  verified by the bench signature, not by binary equality (the code does differ).
+*/
+
+#ifndef NNUE_DUMP_H_INCLUDED
+#define NNUE_DUMP_H_INCLUDED
+
+#include <cstdint>
+
+namespace Stockfish::Eval::NNUE {
+
+// Big-net geometry. Mirrored from nnue_architecture.h; static_assert'd there.
+constexpr int DumpL1  = 1024;  // TransformedFeatureDimensionsBig (2 persp x 512 pairs)
+constexpr int DumpFC0 = 16;    // L2Big + 1  (index 15 is the skip term)
+constexpr int DumpAC0 = 30;    // L2Big * 2  (ac_sqr_0 || ac_0), fc_1 input width
+constexpr int DumpFC1 = 32;    // L3Big
+
+struct DumpBuffer {
+    std::int16_t acc[2][DumpL1];   // accumulation, perspective order (stm first)
+    std::int16_t tacc[2][DumpL1];  // threatAccumulation, same order
+    std::uint8_t l1[DumpL1];       // transformer output: the first nonlinearity
+    std::int32_t fc0[DumpFC0];
+    std::uint8_t ac0[DumpAC0];
+    std::int32_t fc1[DumpFC1];
+    std::uint8_t ac1[DumpFC1];
+    std::int32_t fc2;
+    int          bucket;
+    bool         captured;
+};
+
+// Null in every ordinary code path, including search.
+inline thread_local DumpBuffer* dumpTarget = nullptr;
+
+}  // namespace Stockfish::Eval::NNUE
+
+#endif  // #ifndef NNUE_DUMP_H_INCLUDED
