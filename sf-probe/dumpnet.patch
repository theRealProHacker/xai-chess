diff --git a/src/nnue/nnue_misc.cpp b/src/nnue/nnue_misc.cpp
index 66a6764..13615ed 100644
--- a/src/nnue/nnue_misc.cpp
+++ b/src/nnue/nnue_misc.cpp
@@ -35,6 +35,9 @@
 #include "../uci.h"
 #include "network.h"
 #include "nnue_accumulator.h"
+#include "nnue_dump.h"
+#include <fstream>
+#include <deque>
 
 namespace Stockfish::Eval::NNUE {
 
@@ -190,4 +193,146 @@ trace(Position& pos, const Eval::NNUE::Networks& networks, Eval::NNUE::Accumulat
 }
 
 
+
+
+// xai-chess ---------------------------------------------------------------
+// Fixed-size binary dump of the big net's forward pass, one record per FEN.
+// Layout is little-endian and naturally aligned; see tools/nnue_dump.py.
+
+namespace {
+
+constexpr int DumpMaxHalfKA  = 32;   // HalfKAv2_hm::MaxActiveDimensions
+constexpr int DumpMaxThreats = 128;  // FullThreats::MaxActiveDimensions
+
+// Fields are ordered widest-first so the layout is padding-free and the
+// trailing pad is explicit; sizeof is asserted below so the Python reader can
+// rely on a fixed 10780-byte record.
+struct DumpRecord {
+    std::int32_t  psqt;
+    std::int32_t  positional;
+    std::int32_t  simpleEval;
+    std::int32_t  fc2;
+    std::int32_t  idxHalfKA[2][DumpMaxHalfKA];
+    std::int32_t  idxThreats[2][DumpMaxThreats];
+    std::int32_t  fc0[DumpFC0];
+    std::int32_t  fc1[DumpFC1];
+    std::int16_t  acc[2][DumpL1];
+    std::int16_t  tacc[2][DumpL1];
+    std::uint16_t nHalfKA[2];
+    std::uint16_t nThreats[2];
+    std::uint8_t  l1[DumpL1];
+    std::uint8_t  ac0[DumpAC0];
+    std::uint8_t  ac1[DumpFC1];
+    std::uint8_t  stm;
+    std::uint8_t  bucket;
+    std::uint8_t  inCheck;
+    std::uint8_t  smallNetWouldRun;
+    std::uint8_t  pad[2];
+};
+
+static_assert(sizeof(DumpRecord) == 10780, "DumpRecord layout changed; update tools/nnue_dump.py");
+
+// simple_eval, replicated from evaluate.cpp so the dump is self-contained.
+int dump_simple_eval(const Position& pos) {
+    Color c = pos.side_to_move();
+    return PawnValue * (pos.count<PAWN>(c) - pos.count<PAWN>(~c)) + pos.non_pawn_material(c)
+         - pos.non_pawn_material(~c);
+}
+
+}  // namespace
+
+std::size_t dump_forward(const std::string& fenFile,
+                         const std::string& outFile,
+                         const Networks&    networks,
+                         bool               chess960) {
+
+    std::ifstream in(fenFile);
+    if (!in)
+        return 0;
+    std::ofstream out(outFile, std::ios::binary);
+    if (!out)
+        return 0;
+
+    const char   magic[8]   = {'X', 'A', 'I', 'N', 'N', 'U', 'E', '1'};
+    std::uint32_t version   = 1;
+    std::uint32_t recSize   = sizeof(DumpRecord);
+    std::uint64_t count     = 0;
+    out.write(magic, 8);
+    out.write(reinterpret_cast<const char*>(&version), 4);
+    out.write(reinterpret_cast<const char*>(&recSize), 4);
+    out.write(reinterpret_cast<const char*>(&count), 8);
+
+    AccumulatorCaches caches(networks);
+    auto              accumulators = std::make_unique<AccumulatorStack>();
+    DumpBuffer        buf{};
+    DumpRecord        rec{};
+
+    std::string fen;
+    while (std::getline(in, fen))
+    {
+        while (!fen.empty() && (fen.back() == '\r' || fen.back() == ' '))
+            fen.pop_back();
+        if (fen.empty())
+            continue;
+
+        std::deque<StateInfo> states(1);
+        Position              pos;
+        pos.set(fen, chess960, &states.back());
+
+        rec = DumpRecord{};
+        buf.captured = false;
+
+        accumulators->reset();
+        dumpTarget = &buf;
+        auto [psqt, positional] = networks.big.evaluate(pos, *accumulators, caches.big);
+        dumpTarget = nullptr;
+
+        if (!buf.captured)
+            continue;
+
+        for (Color perspective : {WHITE, BLACK})
+        {
+            // Perspective order matches the net: index 0 is the side to move.
+            const int d = (perspective == pos.side_to_move()) ? 0 : 1;
+
+            PSQFeatureSet::IndexList ka;
+            PSQFeatureSet::append_active_indices(perspective, pos, ka);
+            rec.nHalfKA[d] = std::uint16_t(std::min<std::size_t>(ka.size(), DumpMaxHalfKA));
+            for (std::size_t i = 0; i < rec.nHalfKA[d]; ++i)
+                rec.idxHalfKA[d][i] = std::int32_t(ka[i]);
+
+            ThreatFeatureSet::IndexList th;
+            ThreatFeatureSet::append_active_indices(perspective, pos, th);
+            rec.nThreats[d] = std::uint16_t(std::min<std::size_t>(th.size(), DumpMaxThreats));
+            for (std::size_t i = 0; i < rec.nThreats[d]; ++i)
+                rec.idxThreats[d][i] = std::int32_t(th[i]);
+        }
+
+        rec.psqt             = std::int32_t(psqt);
+        rec.positional       = std::int32_t(positional);
+        rec.simpleEval       = dump_simple_eval(pos);
+        rec.fc2              = buf.fc2;
+        rec.stm              = std::uint8_t(pos.side_to_move());
+        rec.bucket           = std::uint8_t(buf.bucket);
+        rec.inCheck          = std::uint8_t(pos.checkers() ? 1 : 0);
+        rec.smallNetWouldRun = std::uint8_t(std::abs(rec.simpleEval) > 962 ? 1 : 0);
+
+        std::memcpy(rec.acc, buf.acc, sizeof(rec.acc));
+        std::memcpy(rec.tacc, buf.tacc, sizeof(rec.tacc));
+        std::memcpy(rec.l1, buf.l1, sizeof(rec.l1));
+        std::memcpy(rec.fc0, buf.fc0, sizeof(rec.fc0));
+        std::memcpy(rec.ac0, buf.ac0, sizeof(rec.ac0));
+        std::memcpy(rec.fc1, buf.fc1, sizeof(rec.fc1));
+        std::memcpy(rec.ac1, buf.ac1, sizeof(rec.ac1));
+
+        out.write(reinterpret_cast<const char*>(&rec), sizeof(rec));
+        ++count;
+    }
+
+    out.seekp(16);
+    out.write(reinterpret_cast<const char*>(&count), 8);
+    out.close();
+    return count;
+}
+
 }  // namespace Stockfish::Eval::NNUE
