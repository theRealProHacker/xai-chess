@@ -100,6 +100,58 @@ constexpr Bitboard square_bb(Square s) {
 }
 
 
+// xai-chess obstruct operator: the "magic blocker". A phantom occupant on one square that
+// stops slider rays through it without being a piece -- no colour, no material, no Zobrist
+// key, no NNUE feature, and it does not make the square occupied. It is RAY-CLASS SELECTIVE:
+//   lineBlockerOrth  folds into every ROOK-magic lookup   -> cuts rooks, and the orthogonal
+//                                                            component of queens
+//   lineBlockerDiag  folds into every BISHOP-magic lookup -> cuts bishops, and the diagonal
+//                                                            component of queens
+// At most one is ever non-zero, so a queen can have its rays cut on a file while its
+// diagonals stay intact. Pawns, knights, kings and castling are untouched, and any piece may
+// still move onto the square: this obstructs a LINE, not a square. That is the whole point --
+// an operator that denied the square to everything was measuring occupancy, not the line.
+//
+// Both empty (the default) makes the engine byte-for-byte identical to stock Stockfish.
+//
+// Bitboards::init() builds LineBB/BetweenBB/RayPassBB through attacks_bb, so neither may be
+// armed before it runs. UCI options are only read after init, so this holds.
+//
+// One known divergence, deliberate: NNUE sees the blocked ray (its threat features go through
+// attacks_bb) but never the blocker itself, since it is not a piece and so has no feature. The
+// network therefore still values the line it can no longer be used on, which biases the measured
+// effect DOWNWARD. Read the number as a floor, not an estimate.
+extern Bitboard lineBlockerOrth;
+extern Bitboard lineBlockerDiag;
+
+// The UCI state the two bitboards are derived from: a square (SQ_NONE = off) and an axis
+// (0 = rank/file, 1 = diagonal). Kept apart so the two options can arrive in either order --
+// both callbacks recompute the pair.
+extern Square lineBlockerSq;
+extern int    lineBlockerAxis;
+
+// Optional horizon. 0 = no cap (the blocker holds for the whole search). Otherwise the blocker
+// is armed only within this many plies of the ROOT, and the tree beyond it is the real board.
+// Why you would want it: the operator is meant to measure what cutting a line does NOW, and a
+// long search reaches consequences that are not about the line at all. The plainest case is a
+// pawn: it is not a slider, so the blocker cannot stand in its way -- but promote it and the
+// queen it becomes IS a slider whose file the blocker cuts, twelve plies downstream.
+//
+// Caveat, deliberate: the blocker is not in the Zobrist key, so with a cap the SAME position can
+// be searched with the blocker on (shallow) and off (deep) and share one TT entry. Clear Hash
+// between runs, and read a capped measurement as noisier than an uncapped one.
+extern int lineBlockerMaxPly;  // 0 = no cap
+extern int lineBlockerPly;     // plies from the root of the current search
+
+inline void refresh_line_blocker() {
+    Bitboard bb = lineBlockerSq == SQ_NONE ? Bitboard(0) : (1ULL << lineBlockerSq);
+    if (lineBlockerMaxPly && lineBlockerPly >= lineBlockerMaxPly)
+        bb = 0;
+    lineBlockerOrth = lineBlockerAxis == 0 ? bb : Bitboard(0);
+    lineBlockerDiag = lineBlockerAxis == 1 ? bb : Bitboard(0);
+}
+
+
 // Overloads of bitwise operators between a Bitboard and a Square for testing
 // whether a given bit is set in a bitboard, and for setting and clearing bits.
 
@@ -418,9 +470,13 @@ inline Bitboard attacks_bb(Square s, Bitboard occupied) {
 
     switch (Pt)
     {
+    // xai-chess: the magic blocker enters here and only here -- every ray in the engine is a
+    // magic lookup, and the two classes are separate tables, so one OR per table is the whole
+    // operator. QUEEN falls through to both and picks up whichever axis is armed.
     case BISHOP :
+        return Magics[s][Pt - BISHOP].attacks_bb(occupied | lineBlockerDiag);
     case ROOK :
-        return Magics[s][Pt - BISHOP].attacks_bb(occupied);
+        return Magics[s][Pt - BISHOP].attacks_bb(occupied | lineBlockerOrth);
     case QUEEN :
         return attacks_bb<BISHOP>(s, occupied) | attacks_bb<ROOK>(s, occupied);
     default :
