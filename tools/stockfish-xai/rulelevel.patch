 namespace Stockfish {
 
+// xai-chess rule-level intervention (see position.h). Single-threaded use only.
+Square maskPinnerSq = SQ_NONE;
+
+namespace {
+inline bool is_slider(Piece pc) {
+    PieceType pt = type_of(pc);
+    return pt == BISHOP || pt == ROOK || pt == QUEEN;
+}
+
+// True iff square `s` holds an enemy slider relative to the king of color `us`
+// (a bishop, rook, or queen of color ~us). A non-slider, an empty square, or a
+// piece of `us`'s own colour never qualifies. Used at the suppression sites: a
+// check is only ever erased when it comes from such a piece on the armed square.
+inline bool masked_slider_of(const Position& pos, Color us, Square s) {
+    if (s == SQ_NONE)
+        return false;
+    Piece pc = pos.piece_on(s);
+    return pc != NO_PIECE && color_of(pc) == ~us && is_slider(pc);
+}
+
+// True iff square `s` currently holds a slider that genuinely pins exactly one
+// enemy piece to that enemy's king along their common ray, tested against the
+// REAL board (not Stockfish's pinners(), which removes all snipers and so counts
+// a slider stacked behind the real pinner). This is the arming/keep-alive test
+// for the per-node maskPinner: a slider that pins nothing, or checks directly
+// with no blocker, is not a genuine pinner and is never armed.
+inline bool is_genuine_pinner(const Position& pos, Square s) {
+    if (s == SQ_NONE)
+        return false;
+    Piece pc = pos.piece_on(s);
+    if (pc == NO_PIECE || !is_slider(pc))
+        return false;
+    Color    them = ~color_of(pc);  // the side whose king could be pinned
+    Square   ksq  = pos.square<KING>(them);
+    Bitboard betw = between_bb(ksq, s) & ~square_bb(s);  // strictly between king and s
+    Bitboard occ  = betw & pos.pieces();
+    // Exactly one real blocker, of the pinned side, and s must attack the king
+    // once that blocker is lifted (this also rejects a wrong-ray slider).
+    return occ && !more_than_one(occ) && (occ & pos.pieces(them))
+        && (attacks_bb(type_of(pc), s, pos.pieces() ^ occ) & ksq);
+}
+}
+
