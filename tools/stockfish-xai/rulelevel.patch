 namespace Stockfish {
 
+// xai-chess rule-level intervention (see position.h). Single-threaded use only.
+// The obstruct operator's state lives in bitboard.cpp, where the rays are computed.
+Square maskPinnerSq = SQ_NONE;
+
+namespace {
+inline bool is_slider(Piece pc) {
+    PieceType pt = type_of(pc);
+    return pt == BISHOP || pt == ROOK || pt == QUEEN;
+}
+
+// True iff square `s` holds an enemy slider relative to the king of color `us`
+// (a bishop, rook, or queen of color ~us). A non-slider, an empty square, or a
+// piece of `us`'s own colour never qualifies. Used at the suppression sites: a
+// check is only ever erased when it comes from such a piece on the armed square.
+inline bool masked_slider_of(const Position& pos, Color us, Square s) {
+    if (s == SQ_NONE)
+        return false;
+    Piece pc = pos.piece_on(s);
+    return pc != NO_PIECE && color_of(pc) == ~us && is_slider(pc);
+}
+
+// True iff square `s` currently holds a slider that genuinely pins exactly one
+// enemy piece to that enemy's king along their common ray, tested against the
+// REAL board (not Stockfish's pinners(), which removes all snipers and so counts
+// a slider stacked behind the real pinner). This is the arming/keep-alive test
+// for the per-node maskPinner: a slider that pins nothing, or checks directly
+// with no blocker, is not a genuine pinner and is never armed.
+inline bool is_genuine_pinner(const Position& pos, Square s) {
+    if (s == SQ_NONE)
+        return false;
+    Piece pc = pos.piece_on(s);
+    if (pc == NO_PIECE || !is_slider(pc))
+        return false;
+    Color    them = ~color_of(pc);  // the side whose king could be pinned
+    Square   ksq  = pos.square<KING>(them);
+    Bitboard betw = between_bb(ksq, s) & ~square_bb(s);  // strictly between king and s
+    Bitboard occ  = betw & pos.pieces();
+    // Exactly one real blocker, of the pinned side, and s must attack the king
+    // once that blocker is lifted (this also rejects a wrong-ray slider, and an
+    // armed obstruct blocker on the ray, since attacks_bb honours it).
+    return occ && !more_than_one(occ) && (occ & pos.pieces(them))
+        && (attacks_bb(type_of(pc), s, pos.pieces() ^ occ) & ksq);
+}
+
+// xai-chess (relative-pin extension): if the slider on `s` genuinely pins exactly one enemy piece
+// to an enemy BACKSTOP along one of its rays -- the enemy king, OR an enemy piece worth strictly
+// more than the pinned piece -- return that backstop square; else SQ_NONE. Tested against the REAL
+// board. A king backstop reproduces is_genuine_pinner; a more-valuable backstop is a relative pin.
+inline Square pin_backstop(const Position& pos, Square s) {
+    if (s == SQ_NONE)
+        return SQ_NONE;
+    Piece pc = pos.piece_on(s);
+    if (pc == NO_PIECE || !is_slider(pc))
+        return SQ_NONE;
+    Color them = ~color_of(pc);
+    // candidate pinned pieces: enemy pieces the slider directly attacks (first blocker on a ray)
+    Bitboard cand = attacks_bb(type_of(pc), s, pos.pieces()) & pos.pieces(them);
+    while (cand)
+    {
+        Square pinned = pop_lsb(cand);
+        // step one square at a time from `pinned` along the s->pinned ray, to the next occupied square
+        int df = (file_of(pinned) > file_of(s)) - (file_of(pinned) < file_of(s));
+        int dr = (rank_of(pinned) > rank_of(s)) - (rank_of(pinned) < rank_of(s));
+        int step = df + 8 * dr;
+        // xai-chess obstruct: only the blocker matching THIS ray's class ends the walk.
+        Bitboard rayBlocker = (df && dr) ? lineBlockerDiag : lineBlockerOrth;
+        Square back = SQ_NONE;
+        for (Square t = pinned;;)
+        {
+            Square n = Square(int(t) + step);
+            if (!is_ok(n) || distance(t, n) != 1)  // off board or wrapped past a file edge
+                break;
+            t = n;
+            if (rayBlocker & square_bb(t))  // xai-chess: an armed blocker ends the ray
+                break;
+            if (pos.piece_on(t) != NO_PIECE)
+            {
+                back = t;
+                break;
+            }
+        }
+        if (back == SQ_NONE || color_of(pos.piece_on(back)) != them)
+            continue;
+        if (type_of(pos.piece_on(back)) == KING
+            || PieceValue[pos.piece_on(back)] > PieceValue[pos.piece_on(pinned)])
+            return back;
+    }
+    return SQ_NONE;
+}
+}
